# Copy to .env.local and fill in. Names only: no real values are kept in this archive.
# Everything is optional for a local `npm run dev` except where noted.

# --- Auth (Auth.js / next-auth v5) ---
AUTH_SECRET=                 # required for sign-in; e.g. `openssl rand -hex 32`
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=              # Google OAuth client id (optional; password sign-in works without it)
AUTH_GOOGLE_SECRET=

# Comma-separated list of Google account e-mails allowed into /admin. Empty = no admins.
ADMIN_EMAILS=

# --- Public site ---
SITE_URL=http://localhost:3000
GA_ID=                       # Google Analytics 4 id (optional)
GTM_ID=                      # Google Tag Manager id (optional)

# Certificate code used by the homepage "try a sample" button. The archive ships a
# fake placeholder, so the sample lookup finds nothing unless you set a real code
# you are allowed to show publicly.
SAMPLE_CERT_CODE=

# --- HMAC salts (fail closed: the related routes return 503 when unset) ---
PORTAL_REF_SALT=
DIRECTORY_REF_SALT=
VERIFY_IP_SALT=
TRACKING_HMAC_SECRET=

# --- Machine-to-machine bearer tokens (sha256 hex digest of the token, not the token) ---
OUTREACH_UPLOAD_TOKEN_HASH=
LEADS_READ_TOKEN_HASH=

# --- Outreach ---
OUTREACH_DATA_DIR=
OUTREACH_OPEN_PIXEL_ENABLED=  # "1" turns on the open-tracking pixel (off by default)
OUTREACH_MAX_SEGMENTS=
OUTREACH_SEGMENT_MAX_BYTES=

# --- E-mail (SMTP) ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS (phone OTP) ---
SMS_PROVIDER=

# --- Stripe billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=

# --- Google Calendar (call booking) via a service account ---
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# --- Admin impersonation ---
IMPERSONATION_ENABLED=
IMPERSONATION_TTL_MS=

# --- Misc ---
MAX_LOCK_DAYS=
WORKER_RSS_LIMIT_MB=

# --- Registry testing: REGISTRY_MOCK=1 plus per-country base-URL overrides (dev only) ---
REGISTRY_MOCK=
REGISTRY_BASE_EE=
REGISTRY_BASE_UK=
REGISTRY_BASE_NO=
REGISTRY_BASE_DK=
REGISTRY_BASE_FR=
REGISTRY_BASE_HR=
REGISTRY_BASE_CY=
REGISTRY_BASE_BG=
REGISTRY_BASE_AZ=
REGISTRY_BASE_UA=
REGISTRY_BASE_UA_MARAD=
